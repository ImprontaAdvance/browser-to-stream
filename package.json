{
  "name": "browser-to-stream",
  "version": "1.0.0",
  "private": true,
  "description": "Run one browser viewport stream to RTMP from a container",
  "type": "module",
  "engines": {
    "node": "24.20.x"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "format:check": "prettier --check .",
    "start": "node dist/main.js",
    "healthcheck": "node dist/healthcheck.js",
    "test": "tsx --test test/**/*.test.ts",
    "test:e2e": "node test/e2e/smoke.mjs && node test/e2e/resilience.mjs",
    "test:e2e:resilience": "node test/e2e/resilience.mjs",
    "test:e2e:smoke": "node test/e2e/smoke.mjs",
    "test:soak": "node test/e2e/soak.mjs",
    "test:unit": "tsx --test test/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "puppeteer": "25.8.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "eslint": "10.9.1",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0"
  }
}
